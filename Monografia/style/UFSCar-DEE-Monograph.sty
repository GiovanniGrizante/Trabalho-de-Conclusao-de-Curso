        \textbf{\Large\imprimirtitulo}
    \else
        \textbf{\Large\deeltitulouk}
    \fi

    \vspace{2cm}
    
    \abntex@ifnotempty{\imprimirpreambulo}{%   
        \begin{flushright}
            \begin{minipage}{9.5cm}
                \imprimirpreambulo
