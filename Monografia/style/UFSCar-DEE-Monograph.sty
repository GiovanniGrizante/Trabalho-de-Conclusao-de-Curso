  \deelDEELepigrafe
  \end{flushright}
\fi
}


%-----------Formatação do Resumo ----------
\newcommand{\textoresumo}{
    \newpage
    \vspace{1.25cm}
    \pretextualchapter{Resumo}

    {\noindent \sobrenomeautor, \nomeautor, \textbf{\imprimirtitulo}. Trabalho de Conclusão de Curso (Graduação em \deelcurso). Centro de Ciências Exatas e de Tecnologia, Universidade Federal de São Carlos. \pageref{LastPage}~p. \imprimirlocal, \imprimirdata.\par\vspace{6ex}}
    
    \noindent\deelDEELresumo
    
    \vspace{0.75cm}
    
    \noindent{\textbf{Palavras-Chave:}} \deelchave
    %\addcontentsline{toc}{chapter}{Resumo}
    \clearpage
}

%-----------Formatação do Abstract ----------
\newcommand{\textoabstract}{
    \newpage
    \vspace{1.25cm}
    \pretextualchapter{Abstract}

    {\noindent \sobrenomeautor, \nomeautor, \textbf{\deeltitulouk}. Final year thesis (Bachelor degree in Electrical Engineering). Exact and Technology Sciences Center, Federal University of São Carlos. \pageref{LastPage}~p. \imprimirlocal, \imprimirdata.\par\vspace{6ex}}
    
    \noindent\foreignlanguage{english}{\deelDEELabstract}
    
    \vspace{0.75cm}
    
    \noindent{\textbf{Keywords:}} \deelkey
    %\addcontentsline{toc}{chapter}{Abstract}
    \clearpage
}


